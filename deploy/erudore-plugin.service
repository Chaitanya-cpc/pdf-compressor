[Unit]
Description=Erudore PDF compressor web
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/webapps/plugin
Environment=APP_URL=https://plugin.erudore.com
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/root/webapps/plugin/env
ExecStart=/root/webapps/plugin/venv/bin/gunicorn -b 127.0.0.1:6015 -w 2 --timeout 1800 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
