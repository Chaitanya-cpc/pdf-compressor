"""Core compression logic for scanned PDF documents."""

from __future__ import annotations

import io
import os
import tempfile
from dataclasses import dataclass
from pathlib import Path
from typing import Callable, Literal

from PIL import Image, ImageFilter, ImageOps
import pymupdf

Mode = Literal["mono", "gray", "color", "auto"]

MONO_CANDIDATES = [
    3300, 3000, 2800, 2600, 2500, 2400, 2350, 2300, 2200,
    2000, 1900, 1750, 1650, 1500, 1350, 1200, 1050, 900, 800,
]
GRAY_LONG_EDGES = [2000, 1750, 1500, 1300, 1150, 1000, 900, 800, 720, 640]
GRAY_QUALITIES = [85, 80, 75, 70, 65, 55, 45, 35, 25]
# Color needs more room than gray; ladder is a bit more aggressive on size.
COLOR_LONG_EDGES = [2200, 2000, 1750, 1500, 1300, 1150, 1000, 900, 800, 720, 640, 560]
COLOR_QUALITIES = [85, 80, 75, 70, 65, 55, 45, 35, 28, 22]


@dataclass
class CompressionResult:
    output_path: Path
    original_bytes: int
    compressed_bytes: int
    page_count: int
    mode: str
    long_edge_px: int
    jpeg_quality: int | None = None
    note: str | None = None

    @property
    def reduction_percent(self) -> float:
        if self.original_bytes == 0:
            return 0.0
        return (1 - self.compressed_bytes / self.original_bytes) * 100


def parse_target_size_mb(value: str) -> float:
    """Parse target size strings like '2', '2mb', '1.5MB'."""
    text = value.strip().lower().replace(" ", "")
    for suffix in ("mb", "m"):
        if text.endswith(suffix):
            text = text[: -len(suffix)]
            break
    size = float(text)
    if size <= 0:
        raise ValueError("Target size must be greater than 0 MB.")
    return size


def default_output_path(input_path: Path) -> Path:
    return input_path.with_name(f"{input_path.stem} (compressed){input_path.suffix}")


def extract_page_images(pdf_path: Path) -> list[Image.Image]:
    """Extract one RGB image per page from a scanned PDF."""
    doc = pymupdf.open(pdf_path)
    pages: list[Image.Image] = []
    try:
        for page in doc:
            images = page.get_images(full=True)
            if len(images) == 1:
                info = doc.extract_image(images[0][0])
                img = Image.open(io.BytesIO(info["image"])).convert("RGB")
            else:
                pix = page.get_pixmap(dpi=300, alpha=False)
                img = Image.frombytes("RGB", (pix.width, pix.height), pix.samples)
            pages.append(img)
    finally:
        doc.close()
    if not pages:
        raise ValueError(f"No pages found in {pdf_path}")
    return pages


def resize_long_edge(image: Image.Image, long_edge_px: int) -> Image.Image:
    width, height = image.size
    if max(width, height) <= long_edge_px:
        return image
    scale = long_edge_px / max(width, height)
    return image.resize((int(width * scale), int(height * scale)), Image.LANCZOS)


def encode_mono_pages(pages: list[Image.Image], long_edge_px: int) -> list[bytes]:
    """Convert pages to 1-bit TIFF (CCITT Group 4) for crisp text."""
    encoded: list[bytes] = []
    for image in pages:
        gray = ImageOps.autocontrast(
            resize_long_edge(image, long_edge_px).convert("L"),
            cutoff=1,
        )
        gray = gray.filter(ImageFilter.UnsharpMask(radius=1.0, percent=80, threshold=2))
        bw = gray.point(lambda x: 255 if x > 190 else 0, mode="1")
        buf = io.BytesIO()
        bw.save(buf, format="TIFF", compression="group4")
        encoded.append(buf.getvalue())
    return encoded


def encode_gray_pages(
    pages: list[Image.Image],
    long_edge_px: int,
    quality: int,
) -> list[bytes]:
    """Convert pages to grayscale JPEG."""
    encoded: list[bytes] = []
    for image in pages:
        gray = resize_long_edge(image, long_edge_px).convert("L")
        buf = io.BytesIO()
        gray.save(buf, format="JPEG", quality=quality, optimize=True, progressive=True)
        encoded.append(buf.getvalue())
    return encoded


def encode_color_pages(
    pages: list[Image.Image],
    long_edge_px: int,
    quality: int,
) -> list[bytes]:
    """Convert pages to colour JPEG (RGB)."""
    encoded: list[bytes] = []
    for image in pages:
        rgb = resize_long_edge(image, long_edge_px).convert("RGB")
        buf = io.BytesIO()
        rgb.save(buf, format="JPEG", quality=quality, optimize=True, progressive=True)
        encoded.append(buf.getvalue())
    return encoded


def _is_tiff(data: bytes) -> bool:
    return data[:4] in (b"II*\x00", b"MM\x00*")


def build_pdf_from_images(image_bytes_list: list[bytes], output_path: Path) -> int:
    """Assemble page images into a PDF without re-encoding."""
    import img2pdf

    output_path.parent.mkdir(parents=True, exist_ok=True)

    with tempfile.TemporaryDirectory() as tmpdir:
        paths: list[str] = []
        ext = "tiff" if _is_tiff(image_bytes_list[0]) else "jpg"
        for index, data in enumerate(image_bytes_list):
            page_path = Path(tmpdir) / f"page_{index:04d}.{ext}"
            page_path.write_bytes(data)
            paths.append(str(page_path))

        with open(output_path, "wb") as pdf_file:
            img2pdf.convert(*paths, outputstream=pdf_file, pagesize="A4")

    return os.path.getsize(output_path)


def _search_mono(
    pages: list[Image.Image],
    output_path: Path,
    target_bytes: int,
    on_attempt: Callable[[str], None] | None,
) -> tuple[int, int] | None:
    for long_edge in MONO_CANDIDATES:
        images = encode_mono_pages(pages, long_edge)
        size = build_pdf_from_images(images, output_path)
        if on_attempt:
            on_attempt(f"mono  long_edge={long_edge:4d}px -> {size / 1024 / 1024:5.2f} MB")
        if size <= target_bytes:
            return long_edge, size
    return None


def _search_gray(
    pages: list[Image.Image],
    output_path: Path,
    target_bytes: int,
    on_attempt: Callable[[str], None] | None,
) -> tuple[int, int, int] | None:
    for long_edge in GRAY_LONG_EDGES:
        for quality in GRAY_QUALITIES:
            images = encode_gray_pages(pages, long_edge, quality)
            size = build_pdf_from_images(images, output_path)
            if on_attempt:
                on_attempt(
                    f"gray  long_edge={long_edge:4d}px quality={quality:2d} -> "
                    f"{size / 1024 / 1024:5.2f} MB"
                )
            if size <= target_bytes:
                return long_edge, quality, size
    return None


def _search_color(
    pages: list[Image.Image],
    output_path: Path,
    target_bytes: int,
    on_attempt: Callable[[str], None] | None,
) -> tuple[int, int, int] | None:
    for long_edge in COLOR_LONG_EDGES:
        for quality in COLOR_QUALITIES:
            images = encode_color_pages(pages, long_edge, quality)
            size = build_pdf_from_images(images, output_path)
            if on_attempt:
                on_attempt(
                    f"color long_edge={long_edge:4d}px quality={quality:2d} -> "
                    f"{size / 1024 / 1024:5.2f} MB"
                )
            if size <= target_bytes:
                return long_edge, quality, size
    return None


def compress_pdf(
    input_path: str | Path,
    target_size_mb: float | str,
    output_path: str | Path | None = None,
    mode: Mode = "auto",
    on_progress: Callable[[str], None] | None = None,
) -> CompressionResult:
    """
    Compress a scanned PDF to at or below the target size.

    Uses mono (1-bit CCITT) compression by default for text scans, which keeps
    text sharp while achieving large size reductions. Falls back to grayscale
    JPEG when mode is 'gray' or when mono cannot reach the target.

    Colour mode tries RGB JPEG first; if the target cannot be hit in colour,
    it falls back to grayscale and sets ``note`` explaining the fallback.
    """
    src = Path(input_path).expanduser().resolve()
    if not src.is_file():
        raise FileNotFoundError(f"Input file not found: {src}")

    if isinstance(target_size_mb, str):
        target_mb = parse_target_size_mb(target_size_mb)
    else:
        target_mb = float(target_size_mb)
        if target_mb <= 0:
            raise ValueError("Target size must be greater than 0 MB.")

    dst = Path(output_path).expanduser().resolve() if output_path else default_output_path(src)
    target_bytes = int(target_mb * 1024 * 1024)
    original_bytes = src.stat().st_size

    if on_progress:
        on_progress(f"Reading {src.name} ({original_bytes / 1024 / 1024:.2f} MB)...")

    pages = extract_page_images(src)
    if on_progress:
        on_progress(f"Found {len(pages)} page(s). Target: {target_mb:.2f} MB.")

    selected_mode = mode
    long_edge = 0
    jpeg_quality: int | None = None
    compressed_bytes = 0
    note: str | None = None

    if mode == "color":
        if on_progress:
            on_progress("Trying colour JPEG compression...")
        color_result = _search_color(pages, dst, target_bytes, on_progress)
        if color_result:
            long_edge, jpeg_quality, compressed_bytes = color_result
            selected_mode = "color"
        else:
            if on_progress:
                on_progress(
                    "Colour could not hit the target — falling back to grayscale..."
                )
            gray_result = _search_gray(pages, dst, target_bytes, on_progress)
            if not gray_result:
                raise RuntimeError(
                    f"Could not compress below {target_mb:.2f} MB in colour or gray. "
                    "Try a larger target size."
                )
            long_edge, jpeg_quality, compressed_bytes = gray_result
            selected_mode = "gray"
            note = (
                f"Colour could not reach {target_mb:.2f} MB while staying usable. "
                "Delivered grayscale instead."
            )
    else:
        if mode in ("auto", "mono"):
            if on_progress:
                on_progress("Trying mono compression (best for scanned text)...")
            mono_result = _search_mono(pages, dst, target_bytes, on_progress)
            if mono_result:
                long_edge, compressed_bytes = mono_result
                selected_mode = "mono"
            elif mode == "mono":
                raise RuntimeError(
                    f"Could not compress below {target_mb:.2f} MB using mono mode. "
                    "Try a larger target size or use --mode gray / color."
                )

        if selected_mode != "mono":
            if on_progress:
                on_progress("Trying grayscale JPEG compression...")
            gray_result = _search_gray(pages, dst, target_bytes, on_progress)
            if not gray_result:
                raise RuntimeError(
                    f"Could not compress below {target_mb:.2f} MB. "
                    "Try a larger target size."
                )
            long_edge, jpeg_quality, compressed_bytes = gray_result
            selected_mode = "gray"

    return CompressionResult(
        output_path=dst,
        original_bytes=original_bytes,
        compressed_bytes=compressed_bytes,
        page_count=len(pages),
        mode=selected_mode,
        long_edge_px=long_edge,
        jpeg_quality=jpeg_quality,
        note=note,
    )
